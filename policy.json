{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::825765398657:user/careautomate-s3-user"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::careautomate-s3-user",
        "arn:aws:s3:::careautomate-s3-user/*",
        "arn:aws:s3:::careautomate-s3-user/documents/*"
      ]
    }
  ]
} 